{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit customer'|trans }}{% endblock %}
{% block body_testid %}customer-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.customers') }}">{{ 'Customers'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ customer.firstname }} {{ customer.lastname }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('customer-edit.top', { customer_id: customer.id }) }}

    <div class="container-fluid" data-testid="customer-edit-page">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0" data-testid="customer-edit-title">
                {{ 'Edit customer'|trans }}: <span class="text-muted">{{ customer.firstname }} {{ customer.lastname }}</span>
                <small class="text-secondary ms-2">{{ customer.ref }}</small>
                {% if customer.isGuest %}
                    <span class="badge text-bg-warning-subtle text-warning-emphasis ms-2" data-testid="customer-edit-guest-badge">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i> {{ 'Ordered without creating an account'|trans }}
                    </span>
                {% endif %}
            </h1>
            {% include '@BackOfficeDefaultTwig/_prev_next_buttons.html.twig' with {
                prev_url: prev_url|default(null),
                next_url: next_url|default(null),
                prev_label: 'Edit previous customer'|trans,
                next_label: 'Edit next customer'|trans,
                testid: 'customer',
            } only %}
        </div>

        {{ form_start(form, {
            action: path('admin.customer.update.process'),
            method: 'post',
            attr: { 'data-testid': 'customer-edit-form' },
        }) }}
            <input type="hidden" name="customer_id" value="{{ customer.id }}">
            {% if form.id is defined %}{{ form_widget(form.id) }}{% endif %}

            <div class="row g-3">
                {# Left column — identity, account, address, contact #}
                <div class="col-xl-8">
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-person" aria-hidden="true"></i> {{ 'Personal information'|trans }}
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-2">{{ form_row(form.title) }}</div>
                                <div class="col-md-5">{{ form_row(form.firstname) }}</div>
                                <div class="col-md-5">{{ form_row(form.lastname) }}</div>
                                <div class="col-12">{{ form_row(form.email) }}</div>
                            </div>
                        </div>
                    </div>

                    {% if form.password is defined %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <i class="bi bi-key" aria-hidden="true"></i> {{ 'Reset password'|trans }}
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">{{ form_row(form.password) }}</div>
                                    <div class="col-md-6">{{ form_row(form.password_confirm) }}</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-geo-alt" aria-hidden="true"></i> {{ 'Default address'|trans }}
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">{{ form_row(form.address1) }}</div>
                                <div class="col-md-6">{{ form_row(form.address2) }}</div>
                                <div class="col-md-6">{{ form_row(form.address3) }}</div>
                                <div class="col-md-6">{{ form_row(form.zipcode) }}</div>
                                <div class="col-md-6">{{ form_row(form.city) }}</div>
                                <div class="col-12" data-controller="bo-state-cascade">
                                    <div class="row g-3">
                                        <div class="col-md-6">{{ form_row(form.country) }}</div>
                                        <div class="col-md-6" data-bo-state-cascade-target="wrapper">{{ form_row(form.state) }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-telephone" aria-hidden="true"></i> {{ 'Contact'|trans }}
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">{{ form_row(form.phone) }}</div>
                                <div class="col-md-6">{{ form_row(form.cellphone) }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Right column — business + preferences + meta #}
                <div class="col-xl-4">
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-building" aria-hidden="true"></i> {{ 'Business'|trans }}
                        </div>
                        <div class="card-body">
                            {{ form_row(form.company) }}
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-sliders" aria-hidden="true"></i> {{ 'Preferences'|trans }}
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12">{{ form_row(form.lang_id) }}</div>
                                <div class="col-12">{{ form_row(form.discount) }}</div>
                                <div class="col-12">{{ form_row(form.reseller) }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-body small text-muted d-flex align-items-center gap-2">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            {{ 'Registered on %date'|trans({ '%date': customer.createdAt ? customer.createdAt|format_datetime('medium', 'short') : '-' }) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-4">
                <a href="{{ path('admin.customers') }}" class="btn btn-outline-secondary" data-testid="customer-edit-cancel">
                    {{ 'Cancel'|trans }}
                </a>
                <button type="submit" class="btn btn-primary" data-testid="customer-edit-submit">
                    <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                </button>
            </div>
        {{ form_end(form) }}

        {{ safe_hook('customer.edit', { customer_id: customer.id }) }}

        <div class="card mt-4" data-testid="customer-addresses-section">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>{{ 'Addresses'|trans }} <span class="badge bg-secondary ms-1">{{ addresses|length }}</span></span>
                {% if is_granted('CREATE', 'admin.address') %}
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#customer-address-create-modal" data-testid="customer-address-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new address'|trans }}
                    </button>
                {% endif %}
            </div>
            <div class="card-body">
                {% if addresses is empty %}
                    <p class="text-muted mb-0">{{ 'No address registered for this customer.'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" data-testid="customer-addresses-table">
                            <thead class="table-light">
                                <tr>
                                    <th>{{ 'Label'|trans }}</th>
                                    <th>{{ 'Name'|trans }}</th>
                                    <th>{{ 'Address'|trans }}</th>
                                    <th class="text-end">{{ 'Actions'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for addr in addresses %}
                                    <tr data-testid="customer-address-row" data-address-id="{{ addr.id }}">
                                        <td>
                                            {{ addr.label }}
                                            {% if addr.is_default %}<span class="badge bg-success ms-1">{{ 'Default'|trans }}</span>{% endif %}
                                        </td>
                                        <td>{{ addr.firstname }} {{ addr.lastname }}</td>
                                        <td class="text-muted small">{{ addr.address }}</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1 justify-content-end">
                                                <a href="{{ path('admin.address.update.view', { address_id: addr.id }) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'Edit'|trans }}" data-testid="customer-address-edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                {% if not addr.is_default and is_granted('UPDATE', 'admin.address') %}
                                                    <form method="post" action="{{ path('admin.address.makeItDefault') }}?_token={{ assignToken() }}" class="d-inline">
                                                        <input type="hidden" name="address_id" value="{{ addr.id }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="{{ 'Set as default'|trans }}" data-testid="customer-address-default">
                                                            <i class="bi bi-star"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                {% if is_granted('DELETE', 'admin.address') %}
                                                    <form method="post" action="{{ path('admin.address.delete') }}?_token={{ assignToken() }}" class="d-inline" onsubmit="return confirm('{{ 'Delete this address?'|trans|e('js') }}');">
                                                        <input type="hidden" name="address_id" value="{{ addr.id }}">
                                                        {{ safe_hook('customer.address-delete-form', { customer_id: customer.id, location: 'customer_address_delete_form' }) }}
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'Delete'|trans }}" data-testid="customer-address-delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="card mt-4" data-testid="customer-orders-section">
            <div class="card-header">
                {{ 'Orders for this customer'|trans }}
                <span class="badge bg-secondary ms-1">{{ orders_total|default(0) }}</span>
            </div>
            <div class="card-body p-0">
                {% if recent_orders is empty %}
                    <p class="text-muted mb-0 p-3">{{ 'This customer has not placed any order yet.'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" data-testid="customer-orders-table">
                            <thead class="table-light">
                                <tr>
                                    <th>{{ 'Reference'|trans }}</th>
                                    <th>{{ 'Date'|trans }}</th>
                                    <th>{{ 'Status'|trans }}</th>
                                    <th class="text-end">{{ 'Total'|trans }}</th>
                                    <th class="text-end">{{ 'Actions'|trans }}</th>
                                    {{ safe_hook('customer.orders-table-header', { customer_id: customer.id, location: 'orders_table_header' }) }}
                                </tr>
                            </thead>
                            <tbody>
                                {% for order in recent_orders %}
                                    <tr data-testid="customer-order-row" data-order-id="{{ order.id }}">
                                        <td><a href="{{ order.edit_url }}" class="link-primary text-decoration-none fw-medium">{{ order.ref }}</a></td>
                                        <td>{{ order.created_at ? order.created_at|format_datetime('medium', 'short') : '-' }}</td>
                                        <td><span class="badge" style="background-color: {{ order.status_color }};">{{ order.status_title }}</span></td>
                                        <td class="text-end">{{ order.amount|number_format(2, '.', ' ') }} {{ order.currency_symbol }}</td>
                                        <td class="text-end">
                                            <a href="{{ order.edit_url }}" class="btn btn-sm btn-outline-primary" data-testid="customer-order-view">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                        {{ safe_hook('customer.orders-table-row', { customer_id: customer.id, order_id: order.id, location: 'orders_table_row' }) }}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if orders_last_page|default(1) > 1 %}
                        <div class="card-footer">
                            {{ component('BoPagination', {
                                route: 'admin.customer.update.view',
                                currentPage: orders_page,
                                lastPage: orders_last_page,
                                routeParams: { customer_id: customer.id },
                                pageParam: 'orders_page',
                                ariaLabel: 'Customer orders pagination'|trans,
                                testid: 'customer-orders',
                            }) }}
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    {% if address_create_form is defined and is_granted('CREATE', 'admin.address') %}
        {% include '@BackOfficeDefaultTwig/customer/_customer_address_create_modal.html.twig' %}
    {% endif %}

    {{ safe_hook('customer-edit.bottom', { customer_id: customer.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('customer.edit-js', { customer_id: customer.id, location: 'customer-edit-js' }) }}
{% endblock %}
