{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Assortments'|trans }}{% endblock %}
{% block body_testid %}catalog-restrictions{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Assortments'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {% set filter_keep = { scope_type: filter_scope_type, group_id: filter_group_id, customer_q: filter_customer_search ?: null } %}

    <div class="container-fluid" data-testid="catalog-restrictions-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Assortments'|trans }}</h1>
            {% if can_write and is_granted('CREATE', 'admin.pricing') %}
                <a href="{{ path('admin.pricing.catalog_restriction.new') }}" class="btn btn-primary" data-testid="catalog-restriction-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a rule'|trans }}
                </a>
            {% endif %}
        </div>

        <p class="text-muted">
            {{ 'A rule opens or closes a category, a brand or a product to a customer group or to a customer. Once a customer has an allow rule, whatever no allow rule opens is closed to them; a deny rule always wins.'|trans }}
        </p>

        <form method="get" action="{{ path('admin.pricing.catalog_restriction.list') }}" class="row g-2 mb-3" data-testid="catalog-restriction-filter">
            <div class="col-md-3">
                <label class="form-label" for="restriction-filter-scope">{{ 'Rules for'|trans }}</label>
                <select name="scope_type" id="restriction-filter-scope" class="form-select">
                    <option value="">{{ 'Groups and customers'|trans }}</option>
                    <option value="group" {% if filter_scope_type == 'group' %}selected{% endif %}>{{ 'Customer groups'|trans }}</option>
                    <option value="customer" {% if filter_scope_type == 'customer' %}selected{% endif %}>{{ 'Customers'|trans }}</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="restriction-filter-group">{{ 'Customer group'|trans }}</label>
                <select name="group_id" id="restriction-filter-group" class="form-select">
                    <option value="">{{ 'All groups'|trans }}</option>
                    {% for group in groups %}
                        <option value="{{ group.id }}" {% if group.id == filter_group_id %}selected{% endif %}>{{ group.label }}</option>
                    {% endfor %}
                </select>
            </div>
            {% if can_pick_customers %}
                <div class="col-md-4">
                    <label class="form-label" for="restriction-filter-customer">{{ 'Customer (3 characters at least)'|trans }}</label>
                    <input type="search" name="customer_q" id="restriction-filter-customer" class="form-control" value="{{ filter_customer_search }}" maxlength="100" autocomplete="off">
                </div>
            {% endif %}
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-secondary" type="submit">{{ 'Filter'|trans }}</button>
            </div>
        </form>

        {{ component('BoDataTable', {
            id: 'catalog-restrictions',
            columns: [
                column('id', 'ID'|trans, 'start', hideBelow: 'md'),
                column('scope', 'Applies to'|trans),
                column('target', 'Target'|trans),
                column_badge('mode', 'Rule'|trans, { allow: 'success', deny: 'danger' }, 'start', 'mode_label'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No assortment rule matches.'|trans,
        }) }}

        {% if last_page > 1 %}
            {{ component('BoPagination', {
                route: 'admin.pricing.catalog_restriction.list',
                currentPage: current_page,
                lastPage: last_page,
                routeParams: filter_keep,
                ariaLabel: 'Assortment rules pagination'|trans,
                testid: 'catalog-restrictions-pagination',
            }) }}
        {% endif %}

        <div class="card mt-4" data-testid="catalog-restriction-counter">
            <div class="card-header">{{ 'Products left visible'|trans }}</div>
            <div class="card-body">
                <p class="text-muted small">{{ 'How many products the rules above leave to a customer group or to a customer. What the list of categories of a customer group closes is not counted here.'|trans }}</p>
                <form method="get" action="{{ path('admin.pricing.catalog_restriction.list') }}" class="row g-2">
                    {% for name, value in filter_keep|filter(value => value is not null and value != '') %}
                        <input type="hidden" name="{{ name }}" value="{{ value }}">
                    {% endfor %}
                    <div class="col-md-4">
                        <label class="form-label" for="restriction-view-group">{{ 'Customer group'|trans }}</label>
                        <select name="view_group_id" id="restriction-view-group" class="form-select" data-testid="catalog-restriction-view-group">
                            <option value="">-</option>
                            {% for group in groups %}
                                <option value="{{ group.id }}" {% if group.id == counter.group_id %}selected{% endif %}>{{ group.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% if can_pick_customers %}
                        <div class="col-md-5">
                            <label class="form-label" for="restriction-view-customer">{{ 'Or a customer (3 characters at least)'|trans }}</label>
                            <input type="search" name="view_customer_q" id="restriction-view-customer" class="form-control" value="{{ counter.customer_search }}" maxlength="100" autocomplete="off" data-testid="catalog-restriction-view-customer">
                        </div>
                    {% endif %}
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-secondary" type="submit" data-testid="catalog-restriction-view-submit">{{ 'Count'|trans }}</button>
                    </div>
                </form>

                {% if counter.customer_results is not empty %}
                    <ul class="list-group mt-3" data-testid="catalog-restriction-view-results">
                        {% for customer in counter.customer_results %}
                            <li class="list-group-item">
                                <a href="{{ path('admin.pricing.catalog_restriction.list', filter_keep|merge({ view_customer_id: customer.id })) }}">{{ customer.label }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if counter.result is not null %}
                    <p class="mt-3 mb-0" data-testid="catalog-restriction-view-result">
                        <strong>{{ counter.label }}</strong>:
                        <span data-testid="catalog-restriction-view-visible">{{ counter.result.visible }}</span>
                        {{ 'products visible out of'|trans }}
                        <span data-testid="catalog-restriction-view-total">{{ counter.result.total }}</span>
                    </p>
                {% endif %}
            </div>
        </div>
    </div>

    {% if can_write %}
        {{ component('BoConfirmDialog', {
            id: 'catalog-restriction-delete-modal',
            title: 'Delete the assortment rule',
            formAction: path('admin.pricing.catalog_restriction.delete'),
            message: 'Do you really want to delete this assortment rule? The customers it bound see the catalog the other rules leave them.',
            testid: 'catalog-restriction-delete',
            prefillTrigger: 'data-restriction-id',
            prefillInput: 'restriction_id',
        }) }}
    {% endif %}
{% endblock %}
