{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Coupons'|trans }}{% endblock %}
{% block body_testid %}coupons-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Coupons'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('coupon.top') }}

    <div class="container-fluid" data-testid="coupons-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Coupons'|trans } %}
            {% block actions %}
                {% if is_granted('CREATE', 'admin.coupon') %}
                    <a href="{{ path('admin.coupon.create') }}" class="btn btn-primary btn-sm" data-testid="coupon-create-button">
                        <i class="bi bi-plus-circle"></i> {{ 'Create a new coupon'|trans }}
                    </a>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {{ safe_hook('coupon.list-caption') }}

        <form method="get" action="{{ path('admin.coupon.default') }}" class="row g-2 mb-3" data-testid="coupons-filter-form">
            {# Filtering must not silently reset the column the merchant sorted on. #}
            <input type="hidden" name="order" value="{{ sort_field }}">
            <input type="hidden" name="direction" value="{{ sort_direction }}">
            <div class="col-md-4">
                <label class="form-label" for="coupon-mode-filter">{{ 'Filter by trigger mode'|trans }}</label>
                <select name="mode" id="coupon-mode-filter" class="form-select" data-testid="coupons-mode-filter">
                    {% for choice in mode_filter_choices %}
                        <option value="{{ choice.value }}" {% if choice.value == current_mode %}selected{% endif %}>{{ choice.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-secondary" type="submit">{{ 'Filter'|trans }}</button>
            </div>
        </form>

        {{ component('BoDataTable', {
            id: 'coupons',
            columns: [
                column('id', 'ID'|trans, 'start', 'id', visibleFrom: 'md'),
                column('code', 'Code'|trans, 'start', 'code'),
                column_badge('mode', 'Mode'|trans, { code: 'secondary', automatic: 'info' }, labelKey: 'mode_label', visibleFrom: 'lg'),
                column('title', 'Title'|trans, 'start', 'title'),
                column('type', 'Type'|trans, visibleFrom: 'xl'),
                column_badge('enabled_label', 'Status'|trans, { Enabled: 'success', Disabled: 'secondary' }, 'start', null, null, 'is_enabled'),
                column('start_date', 'Start date'|trans, visibleFrom: 'xl'),
                column('expiration_date', 'Expiration date'|trans, 'start', 'expiration_date', visibleFrom: 'lg'),
                column('days_left', 'Days left'|trans, 'center', visibleFrom: 'xl'),
                column('usages_left', 'Usages left'|trans, 'center', visibleFrom: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No coupon is currently defined. Use the (+) button above to create your first coupon.'|trans,
            extraColumnsHeaderHook: 'coupon.table-header',
            extraColumnsHook: 'coupon.table-row',
            headerHookContext: { location: 'coupon_table_header' },
            rowHookContext: { location: 'coupon_table_row' },
            rowHookArgs: { coupon_id: 'id' },
            sortField: sort_field,
            sortDirection: sort_direction,
            sortKeepParams: { page: current_page > 1 ? current_page : null, mode: current_mode != 'all' ? current_mode : null },
            rowIdentifierKey: 'code',
        }) }}

        {{ component('BoPagination', {
            route: 'admin.coupon.default',
            currentPage: current_page,
            lastPage: pages,
            routeParams: { mode: current_mode != 'all' ? current_mode : null, order: sort_field, direction: sort_direction },
            ariaLabel: 'Coupons pagination',
            testid: 'coupons-pagination',
        }) }}
    </div>

    {{ safe_hook('coupon.bottom') }}

    {{ component('BoConfirmDialog', {
        id: 'coupon-delete-modal',
        title: 'Delete coupon',
        formAction: path('admin.coupon.delete'),
        message: 'Do you really want to delete this coupon ?',
        testid: 'coupon-delete',
        hook: 'coupon.delete-form',
        prefillTrigger: 'data-coupon-id',
        prefillInput: 'coupon_id',
    }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('coupon.list-js', { location: 'coupon-list-js' }) }}
{% endblock %}
