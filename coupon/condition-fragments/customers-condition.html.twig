{% set selected_operator = validators.setOperators[field_name] ?? 'in' %}
<div class="mb-3">
    <label class="form-label">{{ 'Customer is :'|trans }}</label>
    <div class="row g-2">
        <div class="col-md-4">
            <select class="form-select" name="{{ field_name }}[operator]">
                {% for op in available_operators[field_name] ?? [] %}
                    <option value="{{ op.value }}" {{ op.value == selected_operator ? 'selected' : '' }}>{{ op.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-8">
            {% include '@BackOfficeDefaultTwig/fragments/customer-multiselect.html.twig' with {
                name: field_name ~ '[value][]',
                choices: customers_choices,
                selected: selected_values,
                testid: 'coupon-customers',
                required: true,
                with_email: customers_choices_show_email,
            } only %}
        </div>
    </div>
</div>
