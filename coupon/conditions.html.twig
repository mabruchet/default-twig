{% set can_reorder = coupon_id is defined and coupon_id and conditions|length > 1 %}

{% set rows = [] %}
{% for entry in conditions %}
    {% set rows = rows|merge([{
        'id': entry.index,
        'description_html': (not loop.first ? '<span class="badge bg-info-subtle text-info-emphasis me-2">' ~ 'And'|trans ~ '</span>' : '') ~ entry.summary,
        '_actions': [
            row_action('edit', 'Change this condition'|trans, null, null, null, null, {
                'condition-service-id': entry.serviceId,
                'condition-index': entry.index,
            }),
        ]|merge(conditions|length > 1 ? [
            row_action('delete', 'Delete this condition'|trans, null, null, null, null, {
                'condition-index': entry.index,
            }),
        ] : []),
    }]) %}
{% endfor %}

{{ component('BoDataTable', {
    id: 'conditions',
    columns: [
        column_html('description_html', 'Condition description'|trans),
        column_actions(),
    ],
    rows: rows,
    emptyMessage: 'No condition. The coupon will apply to every order.'|trans,
    tbodyAttributes: can_reorder ? {
        'data-controller': 'bo-sortable',
        'data-bo-sortable-url-value': path('admin.coupon.condition.reorder', { 'couponId': coupon_id }),
        'data-bo-sortable-token-value': assignToken(),
        'data-bo-sortable-param-name-value': 'id',
    } : {},
}) }}
