{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ role ? 'Buyer role'|trans : 'New buyer role'|trans }}{% endblock %}
{% block body_testid %}configuration-company-role{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.company-roles.list') }}">{{ 'Buyer roles'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ role ? role.code : 'New buyer role'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="company-role-page">
        <h1 class="h3 mb-3">{{ role ? 'Buyer role'|trans : 'New buyer role'|trans }}{% if role %} <small class="text-muted"><code>{{ role.code }}</code></small>{% endif %}</h1>

        {% if shipped %}
            <p class="text-muted" data-testid="company-role-shipped-note">{{ 'The roles the shop installs are read only: the shop looks them up by their code.'|trans }}</p>
        {% elseif role and buyers > 0 %}
            <p class="text-muted">{{ '%count% buyer(s)'|trans({'%count%': buyers}) }}. {{ 'A change of permissions applies to them at once.'|trans }}</p>
        {% endif %}

        <div class="mb-3">
            {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
        </div>

        <div class="card">
            <div class="card-body">
                {{ include('@BackOfficeDefaultTwig/company/_role_form.html.twig', {
                    action: path('admin.configuration.company-roles.save'),
                    role: role ? { id: role.id, code: role.code } : null,
                    granted: granted,
                    title: title,
                    labels: permission_labels,
                    edit_language_id: edit_language_id,
                    testid: 'company-role',
                    read_only: shipped or not can_update,
                }) }}
            </div>
        </div>
        <div class="mt-3">
            <a href="{{ path('admin.configuration.company-roles.list') }}" class="btn btn-outline-secondary">{{ 'Back'|trans }}</a>
        </div>
    </div>
{% endblock %}
