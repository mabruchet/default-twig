{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Buyer roles'|trans }}{% endblock %}
{% block body_testid %}configuration-company-roles{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Buyer roles'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="company-roles-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Buyer roles'|trans }}</h1>
            {% if can_create %}
                <a href="{{ path('admin.configuration.company-roles.new') }}" class="btn btn-primary" data-testid="company-role-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a role'|trans }}
                </a>
            {% endif %}
        </div>

        <p class="text-muted">{{ 'A role lists what a buyer may do for the company. Every company can give these roles; the roles the shop installs are read only. A role that belongs to one company is made on the sheet of that company.'|trans }}</p>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0" data-testid="company-roles-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">{{ 'Title'|trans }}</th>
                            <th scope="col">{{ 'Code'|trans }}</th>
                            <th scope="col">{{ 'Permissions'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'Buyers'|trans }}</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for role in roles %}
                            <tr data-testid="company-role-row-{{ role.code }}">
                                <td>{{ role.title }}{% if role.shipped %} <span class="badge text-bg-secondary">{{ 'Installed'|trans }}</span>{% endif %}</td>
                                <td><code>{{ role.code }}</code></td>
                                <td class="small">
                                    {% for permission in role.permissions %}
                                        <span class="badge text-bg-light border">{{ (permission_labels[permission] ?? permission)|trans }}</span>
                                    {% endfor %}
                                </td>
                                <td class="text-end">{{ role.buyers }}</td>
                                <td class="text-end text-nowrap">
                                    <a href="{{ path('admin.configuration.company-roles.edit', { role_id: role.id }) }}" class="btn btn-sm btn-outline-secondary">{{ role.shipped or not can_update ? 'View'|trans : 'Edit'|trans }}</a>
                                    {% if can_delete and not role.shipped %}
                                        <form method="post" action="{{ path('admin.configuration.company-roles.delete') }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                                            <input type="hidden" name="role_id" value="{{ role.id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" data-testid="company-role-delete-{{ role.code }}">{{ 'Delete'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
