<div class="card" data-testid="company-infos">
    <div class="card-body">
        <form method="post" action="{{ path('admin.company.save', { company_id: company.id }) }}" data-testid="company-edit-form">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
            <fieldset{% if not can_update %} disabled{% endif %}>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="company-name">{{ 'Name'|trans }}</label>
                        <input type="text" id="company-name" name="name" class="form-control" value="{{ company.name }}" required maxlength="255">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="company-siret">{{ 'SIRET'|trans }}</label>
                        <input type="text" id="company-siret" name="siret" class="form-control" value="{{ company.siret }}" maxlength="20">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="company-vat">{{ 'VAT number'|trans }}</label>
                        <input type="text" id="company-vat" name="vat_number" class="form-control" value="{{ company.vatNumber }}" maxlength="20">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="company-parent">{{ 'Parent company'|trans }}</label>
                        <select id="company-parent" name="parent_id" class="form-select">
                            <option value="">{{ 'None'|trans }}</option>
                            {% for choice in parent_choices %}
                                <option value="{{ choice.id }}"{% if choice.id == company.parentId %} selected{% endif %}>{{ choice.name }}</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">{{ 'Only a note about the structure of the group: it changes nothing for the buyers or the orders.'|trans }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="company-billing">{{ 'Billing address'|trans }}</label>
                        <select id="company-billing" name="billing_address_id" class="form-select" data-testid="company-billing-select">
                            <option value="">{{ 'None'|trans }}</option>
                            {% for choice in billing_address_choices %}
                                <option value="{{ choice.id }}"{% if choice.id == company.billingAddressId %} selected{% endif %}>{{ choice.label }}</option>
                            {% endfor %}
                        </select>
                        <div class="form-text">{{ 'One of the addresses shared with the company. Invoices are made out to it, with the name, the SIRET and the VAT number above.'|trans }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="company-notification">{{ 'Notification e-mail address'|trans }}</label>
                        <input type="email" id="company-notification" name="notification_email" class="form-control" value="{{ company.notificationEmail }}" maxlength="255">
                        <div class="form-text">{{ 'Receives a copy of every e-mail about an order of the company.'|trans }}</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="company-note">{{ 'Internal note'|trans }}</label>
                        <textarea id="company-note" name="internal_note" class="form-control" rows="3">{{ company.internalNote }}</textarea>
                        <div class="form-text">{{ 'For the administrators of the shop only: the company never sees it.'|trans }}</div>
                    </div>
                </div>
            </fieldset>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="{{ path('admin.company.list') }}" class="btn btn-outline-secondary">{{ 'Back'|trans }}</a>
                {% if can_update %}
                    <button type="submit" class="btn btn-primary" data-testid="company-edit-submit"><i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}</button>
                {% endif %}
            </div>
        </form>
    </div>
</div>

{% if can_delete %}
    <div class="card border-danger mt-3" data-testid="company-delete-card">
        <div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-center">
            <div>
                <h2 class="h6 mb-1">{{ 'Delete the company'|trans }}</h2>
                <p class="text-muted small mb-0">{{ 'A company with orders cannot be deleted: suspend it instead.'|trans }}</p>
            </div>
            <form method="post" action="{{ path('admin.company.delete') }}" class="m-0">
                <input type="hidden" name="_token" value="{{ assignToken() }}">
                <input type="hidden" name="company_id" value="{{ company.id }}">
                <button type="submit" class="btn btn-outline-danger" data-testid="company-delete-submit"><i class="bi bi-trash" aria-hidden="true"></i> {{ 'Delete'|trans }}</button>
            </form>
        </div>
    </div>
{% endif %}
