{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Sales'|trans }}{% endblock %}
{% block body_testid %}sales-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Sales'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('sales.top', { location: 'sales_top' }) }}

    <div class="container-fluid" data-testid="sales-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Sales & promotions'|trans } %}
            {% block actions %}
                <a href="{{ global_actions.check_url }}" class="btn btn-outline-secondary btn-sm" data-testid="sales-check-activation"
                   title="{{ 'Refresh the active status of every sale according to its dates.'|trans }}">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> {{ 'Check activation'|trans }}
                </a>
                <a href="{{ global_actions.reset_url }}" class="btn btn-outline-secondary btn-sm" data-testid="sales-reset-status"
                   title="{{ 'Remove the sale flag from every product before recomputing it.'|trans }}">
                    <i class="bi bi-eraser" aria-hidden="true"></i> {{ 'Reset status'|trans }}
                </a>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#sale-create-modal" data-testid="sale-create-btn">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i> {{ 'New sale'|trans }}
                </button>
            {% endblock %}
        {% endembed %}

        {% set table_rows = [] %}
        {% for row in rows %}
            {# A reserved sale names the customers it is for, and the link to a customer
               is deleted with the customer. A sale left at zero is still marked reserved
               yet nobody can see it, so it gets an alert badge rather than the plain one. #}
            {% set reserved_badge = '' %}
            {% if row.reserved and row.targeted_customers_count > 0 %}
                {% set reserved_badge = ' <span class="badge bg-warning-subtle text-warning-emphasis"'
                    ~ ' data-testid="sale-reserved-badge-' ~ row.id ~ '" data-reserved-count="' ~ row.targeted_customers_count ~ '"'
                    ~ ' title="' ~ 'This sale is reserved for named customers.'|trans|e ~ '">'
                    ~ ('Reserved · %count% customer(s)'|trans({'%count%': row.targeted_customers_count}))|e
                    ~ '</span>' %}
            {% elseif row.reserved %}
                {% set reserved_badge = ' <span class="badge bg-danger text-white"'
                    ~ ' data-testid="sale-reserved-badge-' ~ row.id ~ '" data-reserved-count="0"'
                    ~ ' title="' ~ 'Reserved, but no customer is targeted any more: nobody can see this sale. Select customers again, or make it public.'|trans|e ~ '">'
                    ~ '<i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> '
                    ~ 'Reserved · no customer'|trans|e
                    ~ '</span>' %}
            {% endif %}
            {% set table_rows = table_rows|merge([{
                'id': row.id,
                'title_html': '<a href="' ~ row.edit_url|e ~ '" class="fw-semibold text-decoration-none">' ~ (row.title ?: '#' ~ row.id)|e ~ '</a>'
                    ~ reserved_badge,
                'label_html': row.label ? '<span class="badge bg-danger-subtle text-danger-emphasis">' ~ row.label|e ~ '</span>' : '<span class="text-body-secondary">-</span>',
                'start_date': row.start_date ?? '-',
                'end_date': row.end_date ?? '-',
                'offset_type': row.offset_type_label,
                'products': row.products_count,
                'status_html': '<a href="' ~ row.toggle_url|e ~ '" class="text-decoration-none" data-testid="sale-toggle-' ~ row.id ~ '">' ~ (row.active ? '<span class="badge bg-success">' ~ 'Active'|trans ~ '</span>' : '<span class="badge bg-secondary">' ~ 'Inactive'|trans ~ '</span>') ~ '</a>',
                '_actions': [
                    row_action('edit', 'Edit'|trans, row.edit_url),
                    row_action('delete', 'Delete'|trans, null, '#sale-delete-modal', null, null, {'sale-id': row.id}),
                ],
            }]) %}
        {% endfor %}

        {{ component('BoDataTable', {
            id: 'sales',
            columns: [
                column_html('title_html', 'Title'|trans, 'start', 'title'),
                column_html('label_html', 'Label'|trans, visibleFrom: 'xl'),
                column('start_date', 'Start date'|trans, 'start', 'start_date', visibleFrom: 'lg'),
                column('end_date', 'End date'|trans, 'start', 'end_date', visibleFrom: 'lg'),
                column('offset_type', 'Discount type'|trans, visibleFrom: 'xl'),
                column('products', 'Products'|trans, 'center', visibleFrom: 'xl'),
                column_html('status_html', 'Status'|trans, 'center', 'active'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: table_rows,
            emptyMessage: 'No sale yet. Create your first promotion.'|trans,
            sortField: sort_field,
            sortDirection: sort_direction,
            sortParam: 'order',
            sortDirectionParam: 'direction',
            sortKeepParams: query_params is defined ? query_params : {},
            extraColumnsHeaderHook: 'sales.table-header',
            extraColumnsHook: 'sales.table-row',
            rowHookArgs: { sale_id: 'id' },
            rowIdentifierKey: 'title',
        }) }}
    </div>

    <div class="modal fade" id="sale-create-modal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            {% form_theme create_form with bo_form_themes only %}
            {{ form_start(create_form, { action: path('admin.sale.create'), attr: { 'data-testid': 'sale-create-form' } }) }}
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5">{{ 'New sale'|trans }}</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ form_widget(create_form.locale) }}
                        <div class="mb-3">
                            {{ form_label(create_form.title) }}
                            {{ form_widget(create_form.title, { attr: { class: 'form-control' } }) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(create_form.label) }}
                            {{ form_widget(create_form.label, { attr: { class: 'form-control' } }) }}
                            <div class="form-text">{{ 'The short label shown on discounted products (e.g. "Sale", "-20%").'|trans }}</div>
                        </div>
                        {{ safe_hook('sale.create-form', { location: 'sale_create_form' }) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-testid="sale-create-submit">{{ 'Create and configure'|trans }}</button>
                    </div>
                </div>
            {{ form_end(create_form) }}
        </div>
    </div>

    {{ component('BoConfirmDialog', {
        id: 'sale-delete-modal',
        title: 'Delete sale',
        formAction: global_actions.delete_url ~ '?_token=' ~ global_actions.delete_token,
        token: false,
        message: 'Do you really want to delete this sale?',
        testid: 'sale-delete',
        hook: 'sale.delete-form',
        hookContext: { location: 'sale_delete_form' },
        prefillTrigger: 'data-sale-id',
        prefillInput: 'sale_id',
    }) }}

    {{ safe_hook('sales.bottom', { location: 'sales_bottom' }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('sales.js', { location: 'sales-js' }) }}
{% endblock %}
